{
  "manifest_version": 3,
  "name": "Screen Read",
  "short_name": "Screen Read",
  "version": "1.0.0",
  "description": "Grab text from anything on your screen. Drag a box, get the text, copy it. Free, works on your device. By Yathin Looops.",
  "action": { "default_popup": "popup.html", "default_title": "Screen Read: grab text", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "storage"],
  "commands": {
    "select-area": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Select an area and grab its text" }
  },
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" }
}
